# API Configuration
REACT_APP_API_URL=http://localhost:8001/api/v1
# REACT_APP_API_URL=https://admin.cleanestuaire.com/api/v1

# CinetPay Configuration
REACT_APP_CINETPAY_API_KEY=45213166268af015b7d2734.50726534
REACT_APP_CINETPAY_SITE_ID=105905750
REACT_APP_CINETPAY_NOTIFY_URL=https://admin.cleanestuaire.com/api/v1/cinetpay/notify

# Environment
REACT_APP_ENV=development

# Firebase Configuration (for Push Notifications)
# Get these values from Firebase Console > Project Settings > Your apps > Web app
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
# Get VAPID key from Firebase Console > Cloud Messaging > Web Push certificates
REACT_APP_FIREBASE_VAPID_KEY=your_vapid_key